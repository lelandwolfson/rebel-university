# Copy to .env for local use. Never commit real values.
# Required in production: 32+ random characters. Generate with: openssl rand -base64 48
APP_SECRET=
# Optional: enables /admin. 32+ random characters.
ADMIN_SECRET=
# Optional: public URL (default https://rebeluniversity.org in production)
BASE_URL=http://localhost:3000
# Optional email notices. Leave SMTP_HOST empty to run without email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Rebel University <no-reply@rebeluniversity.org>
# Optional: where vulnerability reports go (email or URL) for /.well-known/security.txt
SECURITY_CONTACT=
# Optional AI moderation (see the privacy page and THREAT-MODEL.md T9-T13).
# Without a key, the daily job is skipped and the site works as usual.
ANTHROPIC_API_KEY=
# Optional: read-only token for /admin/digest.json (32+ random characters).
DIGEST_TOKEN=
